{
  "name": "html-email-parser",
  "version": "1.2.0",
  "private": true,
  "description": "Development tooling for the HTML Email Parser Chrome extension.",
  "license": "Apache-2.0",
  "scripts": {
    "lint": "eslint .",
    "validate": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.js",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "package": "python3 -m scripts.package",
    "check": "npm run lint && npm run validate && npm test && npm run test:python"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
